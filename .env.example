# ─── Supabase ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ─── AI (free GitHub Models by default) ─────────────────────
# A GitHub Models token works as AI_API_KEY. All AI routes use this.
AI_API_KEY=your_github_models_token
# Optional fallback key
GITHUB_DEVELOPER_AI_KEY=

# Optional AI tuning knobs (sensible free-tier defaults if unset):
#   AI_BASE_URL    chat-completions endpoint (default: GitHub Models)
#   AI_SMART_MODEL analytical/coaching model (default: gpt-4o)
#   AI_FAST_MODEL  chat/extraction model     (default: gpt-4o-mini)
# AI_BASE_URL=https://models.inference.ai.azure.com/chat/completions
# AI_SMART_MODEL=gpt-4o
# AI_FAST_MODEL=gpt-4o-mini

# ─── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Encryption (required; fail-closed, no fallback) ────────
# Generate a strong random hex value (>= 16 chars), e.g. `openssl rand -hex 32`
ENCRYPTION_KEY=generate_a_strong_random_hex_key

# ─── Google Calendar integration ────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/callback

# ─── Scripture (ESV Bible API) ──────────────────────────────
# Free key: https://api.esv.org/
ESV_API_KEY=your_esv_api_key

# ─── Web Push (VAPID) — free, vendor-less browser notifications ──
# Generate once: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:you@example.com

# ─── Google Fit (Galaxy Watch via Health Connect bridge) ────
# Reuses GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET above. Add this redirect URI in
# the Google Cloud console and enable the Fitness API. See INTEGRATIONS_SETUP.md.
GOOGLE_FIT_REDIRECT_URI=http://localhost:3000/api/fitness/callback

# ─── Unsplash (motivation board imagery) ────────────────────
# Free "Access Key": https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=your_unsplash_access_key

# ─── Spotify (focus / worship playlist embed) ───────────────
# Free app credentials: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# ─── Wger (exercise autocomplete) — no key required ─────────
